{
  "name": "quemat-lab-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:release": "tsc -p tsconfig.release.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server/server/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.ts seed",
    "admin:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.ts admin",
    "account:reset-password": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.ts reset-password",
    "db:backup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.ts backup",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "tsx tests/postgres-concurrency.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@vercel/functions": "^3.10.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@neon/config": "^1.9.3",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
