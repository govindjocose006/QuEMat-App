# Local development defaults; never commit .env or connection credentials.
# Leave NODE_ENV unset locally; Vercel supplies the production runtime.
PORT=3100
APP_ORIGIN=http://localhost:5173
LOCAL_DATABASE_PATH=./data/postgres
TRUST_PROXY_HOPS=0
# Leave DATABASE_URL empty for local PGlite development.
DATABASE_URL=
# Neon CLI also pulls a direct connection for migrations and operator commands.
DATABASE_URL_UNPOOLED=
# Vercel: set DATABASE_URL to Neon's pooled PostgreSQL connection string in
# Vercel environment settings. Never use a VITE_ prefix for database credentials.
# Production APP_ORIGIN must be the exact canonical HTTPS domain.
# Separate preview deployments must use a separate Neon branch/database.
